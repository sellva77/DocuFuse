{
  "name": "docufuse",
  "version": "1.0.2",
  "description": "DocuFuse - Merge Word documents, PDF files, and convert Excel spreadsheets into unified PDF or DOCX documents",
  "main": "dist-electron/main.js",
  "author": "sellva77",
  "license": "MIT",
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:portable": "vite build && electron-builder --win portable",
    "electron:build:all": "vite build && electron-builder --win nsis portable",
    "test": "node tests/testMerge.mjs && node tests/testExcelService.mjs && node tests/testSigning.mjs",
    "test:merge": "node tests/testMerge.mjs",
    "test:excel": "node tests/testExcelService.mjs",
    "test:signing": "node tests/testSigning.mjs"
  },
  "dependencies": {
    "docx": "^9.1.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.docufuse.app",
    "productName": "DocuFuse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "artifactName": "DocuFuseSetup.${ext}"
    },
    "portable": {
      "artifactName": "DocuFusePortable.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
